# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` — it is listed in .gitignore.

# ---- LLM API keys ----
# OpenAI key used when --emulation_model openai or --judge_model openai is set.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio key used when --emulation_model google or --judge_model google is set.
# Get one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ---- Chrome / Selenium ----
# Path to the Chrome executable. Leave empty to use the macOS default
# (/Applications/Google Chrome.app/Contents/MacOS/Google Chrome).
# Set on Linux/Windows or if Chrome is installed in a non-standard location.
CHROME_PATH=

# Directory where Chrome stores the debug profile (cookies, login state, etc.).
# Required — pick a writable directory on your machine; it will be created if needed.
CHROME_USER_DATA_DIR=
